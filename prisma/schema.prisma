generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())

  createdRuleSets        WorklogRuleSet[]
  createdNonWorkingDays  NonWorkingDay[]
  reviewedSlotRecords    SlotRecord[]
  reviewedOffences       AttendanceOffenceReview[]
  createdCompensations   StaffCompensation[]
  finalizedPayrollMonths PayrollMonth[]
}

enum WorkMode {
  OFFICE
  REMOTE
}

model Staff {
  id            String    @id @default(cuid())
  fullName      String
  loginId       String    @unique // phone or email, used to sign in
  passwordHash  String
  position      String    // job title / role, for reporting only
  staffCode     String?   @unique
  department    String?
  dateJoined    DateTime  @default(now())
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  boundDeviceId String?   // device ID this staff member's check-ins are bound to
  deviceBoundAt DateTime? // when boundDeviceId was last (re)bound
  workMode      WorkMode  @default(OFFICE)
  attendances   Attendance[]

  slotRecords          SlotRecord[]
  compensations        StaffCompensation[]
  pushSubscriptions    PushSubscription[]
  notificationLogs     NotificationLog[]
  ruleAcknowledgements RuleAcknowledgement[]
  payrollLines         PayrollLine[]
}

model Attendance {
  id           String   @id @default(cuid())
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id])
  date         DateTime // calendar day this record belongs to (midnight UTC)
  clockIn      DateTime?
  clockInLat   Float?
  clockInLng   Float?
  clockInAccuracy  Float?
  clockOut     DateTime?
  clockOutLat  Float?
  clockOutLng  Float?
  clockOutAccuracy Float?
  // False only when a REMOTE clock-in/out had no GPS available (denied/unavailable)
  // and was still allowed through. Defaults true so every existing row keeps its
  // current meaning (location was always required and present before this field).
  locationShared Boolean @default(true)
  status       String   // ON_TIME | LATE | ABSENT | ANOMALY
  note         String?  // set when admin manually overrides an entry
  overridden   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deviceId             String?
  deviceStatus         DeviceStatus  @default(MATCHED)
  clockOutDeviceId     String?
  clockOutDeviceStatus DeviceStatus?

  offenceReview AttendanceOffenceReview?

  @@unique([staffId, date])
  @@index([date])
}

enum DeviceStatus {
  MATCHED
  UNVERIFIED
  MISMATCH
}

model Settings {
  id                   Int    @id @default(1)
  officeLat            Float
  officeLng            Float
  radiusMeters         Int    @default(100)
  lateThreshold        String @default("08:21") // 24h HH:mm
  /// @deprecated unused since email delivery was removed — kept (with its existing
  /// default) so no existing column is dropped.
  reportEmail          String @default("imarcprojects1@gmail.com")
}

model MonthlyReport {
  id          String   @id @default(cuid())
  periodLabel String   @unique // e.g. "2026-08"
  generatedAt DateTime @default(now())
  /// @deprecated unused since email delivery was removed — kept nullable so no existing
  /// column is dropped; new rows never set this.
  emailedTo   String?
  generatedBy String   // "cron" for the automatic monthly run, or the admin's name for on-demand generation
  summaryJson String   // serialized summary stats, for re-download without recompute
}

// ---------------------------------------------------------------------------
// Worklog & Deductions module (behind WORKLOG_ENABLED). All additive — see
// lib/worklog/ for the domain logic. Nothing above this line is touched by it.
// ---------------------------------------------------------------------------

enum SlotOutcome {
  PENDING
  ON_TIME
  LATE
  MISSED
}

enum ReviewStatus {
  VALID
  FALSE
  EXCUSED
}

model WorklogRuleSet {
  id                 String   @id @default(cuid())
  version            Int
  effectiveFrom      DateTime // Lagos calendar day, stored as UTC midnight
  appliedImmediately Boolean  @default(false)
  overrideReason     String?
  config             Json     // RuleSetConfig — see lib/worklog/config.ts
  createdById        String
  createdBy          Admin    @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  // Set when a later version is published while this one hasn't taken effect yet,
  // so it can never resurface and override the newer version once its own
  // effectiveFrom date arrives. Kept (never deleted) for history.
  supersededAt       DateTime?

  slotRecords      SlotRecord[]
  acknowledgements RuleAcknowledgement[]

  @@unique([version])
}

model NonWorkingDay {
  id          String   @id @default(cuid())
  date        DateTime @unique // Lagos calendar day, stored as UTC midnight
  reason      String
  createdById String
  createdBy   Admin    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model SlotRecord {
  id           String         @id @default(cuid())
  staffId      String
  staff        Staff          @relation(fields: [staffId], references: [id])
  date         DateTime       // Lagos calendar day, stored as UTC midnight
  slotIndex    Int
  slotLabel    String
  slotTime     String         // "HH:mm" snapshot at creation time, for display stability
  ruleSetId    String
  ruleSet      WorklogRuleSet @relation(fields: [ruleSetId], references: [id])
  outcome      SlotOutcome    @default(PENDING)
  tickedAt     DateTime?
  note         String?
  link         String?
  reviewStatus ReviewStatus   @default(VALID)
  reviewReason String?
  reviewedById String?
  reviewedBy   Admin?         @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  notificationLogs NotificationLog[]

  @@unique([staffId, date, slotIndex])
  @@index([date])
}

model AttendanceOffenceReview {
  // Existence of this row means the LATE_CLOCK_IN offence on that Attendance record is excused.
  id                 String     @id @default(cuid())
  attendanceRecordId String     @unique
  attendanceRecord   Attendance @relation(fields: [attendanceRecordId], references: [id])
  reason             String
  reviewedById       String
  reviewedBy         Admin      @relation(fields: [reviewedById], references: [id])
  reviewedAt         DateTime   @default(now())
}

model StaffCompensation {
  // Never edited in place — a new row per change, so salary history is preserved.
  id                String   @id @default(cuid())
  staffId           String
  staff             Staff    @relation(fields: [staffId], references: [id])
  monthlySalaryKobo Int
  grade             String?
  effectiveFrom     DateTime
  createdById       String
  createdBy         Admin    @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())

  @@index([staffId, effectiveFrom])
}

model PayrollMonth {
  id            String    @id @default(cuid())
  month         String    @unique // "YYYY-MM" (Lagos)
  finalizedAt   DateTime?
  finalizedById String?
  finalizedBy   Admin?    @relation(fields: [finalizedById], references: [id])

  lines PayrollLine[]
}

model PayrollLine {
  id                 String       @id @default(cuid())
  payrollMonthId     String
  payrollMonth       PayrollMonth @relation(fields: [payrollMonthId], references: [id])
  staffId            String
  staff              Staff        @relation(fields: [staffId], references: [id])
  baseKobo           Int
  breakdown          Json
  totalBeforeCapKobo Int
  capKobo            Int
  totalDeductionKobo Int
  capped             Boolean
  netKobo            Int
  deductionsEnabled  Boolean

  @@unique([payrollMonthId, staffId])
}

model PushSubscription {
  id            String    @id @default(cuid())
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id])
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
}

model NotificationLog {
  id           String      @id @default(cuid())
  staffId      String
  staff        Staff       @relation(fields: [staffId], references: [id])
  slotRecordId String?
  slotRecord   SlotRecord? @relation(fields: [slotRecordId], references: [id])
  type         String      // "DUE_SOON" | "NOW_LATE" | "WARNING" | "RULES_CHANGED"
  channel      String      // "PUSH" | "EMAIL"
  dedupeKey    String      @unique // guarantees idempotent sends across overlapping/repeated cron runs
  sentAt       DateTime    @default(now())
  error        String?
}

model RuleAcknowledgement {
  id             String         @id @default(cuid())
  staffId        String
  staff          Staff          @relation(fields: [staffId], references: [id])
  ruleSetId      String
  ruleSet        WorklogRuleSet @relation(fields: [ruleSetId], references: [id])
  acknowledgedAt DateTime       @default(now())

  @@unique([staffId, ruleSetId])
}

model WorklogSettings {
  id        Int       @id @default(1)
  // Lagos calendar day, stored as UTC midnight. Null = no restriction (backward
  // compatible with rule sets/data created before this setting existed).
  startDate DateTime?
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   // "ADMIN" | "STAFF" — no single FK possible across two separate tables
  actorId    String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
