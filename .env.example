# Supabase Postgres — Project Settings -> Database -> Connection string.
# DATABASE_URL: the "Transaction pooler" URI (port 6543) the app uses at runtime.
#   Keep ?pgbouncer=true — required since the transaction pooler doesn't support
#   prepared statements the way Prisma expects on a plain connection.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-x-xx-xxxx-x.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: used only by `prisma db push` / `prisma migrate` to change the schema.
#   Use the "Session pooler" URI (same pooler host, port 5432) rather than
#   db.<ref>.supabase.co directly — the direct host is IPv6-only unless you've
#   paid for Supabase's IPv4 add-on, and most networks can't reach it.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-x-xx-xxxx-x.pooler.supabase.com:5432/postgres"

# Random long string used to sign session cookies
AUTH_SECRET="replace-with-a-long-random-string"

# SMTP for the monthly report email (a Gmail account needs an "app password")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="imarcprojects1@gmail.com"
SMTP_PASS="app-password-here"
SMTP_FROM="imarcprojects1@gmail.com"

# Shared secret the Render Cron Job sends to trigger the monthly report
CRON_SECRET="replace-with-another-long-random-string"

# Used once by `npx prisma db seed` to create the first admin login
SEED_ADMIN_EMAIL="admin@imarcprojects.com"
SEED_ADMIN_PASSWORD="changeme123"
