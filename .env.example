# Postgres connection string (Render provides this when you create a Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random long string used to sign session cookies
AUTH_SECRET="replace-with-a-long-random-string"

# SMTP for the monthly report email (a Gmail account needs an "app password")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="imarcprojects1@gmail.com"
SMTP_PASS="app-password-here"
SMTP_FROM="imarcprojects1@gmail.com"

# Shared secret the Render Cron Job sends to trigger the monthly report
CRON_SECRET="replace-with-another-long-random-string"

# Used once by `npx prisma db seed` to create the first admin login
SEED_ADMIN_EMAIL="admin@imarcprojects.com"
SEED_ADMIN_PASSWORD="changeme123"
